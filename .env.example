# Copy to .env.local for local dev; set the same values in
# Vercel > Settings > Environment Variables.
#
# With neither ROSTER_API_* set, the site serves data/fixture.json so a fresh
# clone runs with no setup at all.

# The Apps Script Web App /exec URL. See scripts/roster-webapp.gs for setup.
ROSTER_API_URL=https://script.google.com/macros/s/AKfy.../exec

# Must match the ROSTER_API_TOKEN script property on that Apps Script project.
ROSTER_API_TOKEN=replace-with-a-long-random-string

# Public base URL — used for canonical links and QR payloads.
NEXT_PUBLIC_SITE_URL=https://contact.aibp.sg
