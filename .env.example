# Copy to .env.local for local dev; set the same three in Vercel > Settings > Environment Variables.
# With none of these set, the site falls back to data/fixture.json so it still runs.

GOOGLE_SHEET_ID=1Gz8ZxnFI7dlXKwDK21LqHUh11aQwWVMC_yXfgSSE0MM
GOOGLE_SERVICE_ACCOUNT_EMAIL=contact-site-reader@aibp-contact.iam.gserviceaccount.com

# Paste the private_key value from the service account JSON EXACTLY as it appears,
# including the BEGIN/END lines and the literal \n sequences. Wrap it in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Public base URL, used for canonical links and QR payloads.
NEXT_PUBLIC_SITE_URL=https://contact.aibp.sg
